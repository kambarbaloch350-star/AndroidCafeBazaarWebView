    <!-- ==================== Dark (night) variants ==================== -->
    <!--
      The loading screen is deliberately identical in day and night mode: a pure
      white canvas with green artwork. Dark variants here would repaint the
      splash dark green on devices in dark mode, which is not what this app
      wants – the artwork is white by design.
    -->
