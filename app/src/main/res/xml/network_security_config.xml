<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is *only* permitted for the in-process loopback server that
  serves assets/web/ to the WebView (127.0.0.1 / localhost). Every other host
  keeps the platform default: HTTPS only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
