<?xml version="1.0" encoding="utf-8"?>
<!--
  "Green plate": concentric ring drawn behind the app icon on the loading screen.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/plate_inner_ring" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/plate_surface"
                android:endColor="@color/plate_surface_end"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="@color/plate_ring" />
        </shape>
    </item>
</layer-list>
