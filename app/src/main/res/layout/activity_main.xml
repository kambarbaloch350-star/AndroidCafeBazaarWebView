<?xml version="1.0" encoding="utf-8"?>
<!--
  Container layout.

  WebView  -> renders assets/web/index.html served by the in-process
              local HTTP server. It is attached from the very first frame so
              Chromium can warm up (RendererPriorityPolicy LOW) while the
              native loading plate is still on screen.
  Overlay  -> native loading screen (green plate + Vazirmatn + RTL) which is
              removed only after server + WebView + WebApp readiness.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/loading_background_top">

    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/webview_background" />

    <!-- Native ad plate (Tapsell native ads requested from the WebApp) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/nativeAdPlate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/native_ad_surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/native_ad_border"
        app:strokeWidth="1dp"
        tools:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp">

            <FrameLayout
                android:id="@+id/nativeAdContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

            <TextView
                android:id="@+id/nativeAdStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="22dp"
                android:text="@string/native_ad_loading"
                android:textColor="@color/loading_stage"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/nativeAdClose"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_close_button"
                android:contentDescription="@string/native_ad_close">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Native loading screen: light green / green plate plate theme, RTL. -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/loadingContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:layoutDirection="rtl"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <!-- ================= Animated loading artwork =================
                 White canvas, green artwork: a pulsing halo, the app logo and
                 a rotating gradient ring, then the copy and the credit. -->
            <FrameLayout
                android:id="@+id/loadingEmblem"
                android:layout_width="128dp"
                android:layout_height="128dp">

                <!-- Soft green halo that breathes behind the logo -->
                <View
                    android:id="@+id/loadingHalo"
                    android:layout_width="118dp"
                    android:layout_height="118dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_loading_halo" />

                <com.emochi.quickgames.LoadingRingView
                    android:id="@+id/loadingRing"
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:layout_gravity="center" />

                <ImageView
                    android:id="@+id/loadingLogo"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_labzband" />
            </FrameLayout>

            <TextView
                android:id="@+id/loadingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/vazirmatn_bold"
                android:text="@string/loading_title"
                android:textAppearance="@style/TextAppearance.LoadingTitle" />

            <!-- Tagline – always visible, it is not a boot status. -->
            <TextView
                android:id="@+id/loadingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/vazirmatn_medium"
                android:gravity="center"
                android:text="@string/loading_subtitle"
                android:textAppearance="@style/TextAppearance.LoadingSubtitle" />

            <TextView
                android:id="@+id/loadingMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/vazirmatn_regular"
                android:gravity="center"
                android:text="@string/loading_message"
                android:textAppearance="@style/TextAppearance.LoadingMessage" />

        </LinearLayout>

        <!-- Credit, pinned to the bottom of the loading canvas -->
        <TextView
            android:id="@+id/loadingCredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="34dp"
            android:fontFamily="@font/vazirmatn_medium"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="@string/loading_credit"
            android:textAppearance="@style/TextAppearance.LoadingCredit" />

        <!-- Error / retry state replaces the plate content when booting fails -->
        <LinearLayout
            android:id="@+id/errorContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_error_plate"
            android:elevation="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="30dp"
            android:paddingEnd="28dp"
            android:paddingBottom="30dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/error_title"
                android:src="@drawable/ic_error_state" />

            <TextView
                android:id="@+id/errorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/vazirmatn_bold"
                android:text="@string/error_title"
                android:textAppearance="@style/TextAppearance.ErrorTitle" />

            <TextView
                android:id="@+id/errorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/vazirmatn_regular"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/error_message_default"
                android:textAppearance="@style/TextAppearance.ErrorMessage" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                style="@style/Widget.RetryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/vazirmatn_semibold"
                android:text="@string/error_retry" />
        </LinearLayout>
    </FrameLayout>

    <!-- Fullscreen target for WebChromeClient custom views (video / canvas) -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone" />

</FrameLayout>
