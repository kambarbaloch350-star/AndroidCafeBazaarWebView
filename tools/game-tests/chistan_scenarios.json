  {
    "name": "chistan-economy-fair",
    "steps": [
      {
        "clearStorage": true
      },
      {
        "reload": true,
        "wait": 1000
      },
      {
        "evaluate": "localStorage.getItem('chistansara_game_save_v2') && JSON.parse(localStorage.getItem('chistansara_game_save_v2')).coins",
