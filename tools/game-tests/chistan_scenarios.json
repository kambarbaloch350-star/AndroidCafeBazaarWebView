  {
    "name": "chistan-interstitial-every-3",
    "steps": [
      {
        "clearStorage": true
      },
      {
        "storage": {
          "chistansara_game_save_v2": {
            "currentLevel": 3,
            "coins": 250,
            "completedLevels": {
              "1": {
                "stars": 3,
                "solvedAt": 1
              },
              "2": {
                "stars": 3,
                "solvedAt": 2
              }
            },
            "soundEnabled": true,
            "musicEnabled": true,
            "currentStreak": 2,
            "bestStreak": 2,
            "lastDailyClaim": null,
            "lastSpinTime": null,
            "dailyWheelSpins": {
              "date": "2026-09-24",
              "used": 0
            },
            "rated": false,
            "dailyChallengeSolved": {}
          }
        }
      },
      {
        "reload": true,
        "wait": 1000
      },
      {
        "evaluate": "Object.keys(JSON.parse(localStorage.getItem('chistansara_game_save_v2')).completedLevels).length",
        "expectValue": 2
      },
      {
        "evaluate": "window.__harness.calls.filter(c=>c.includes('showInterstitial')).length",
        "expectValue": 0
      },
      {
        "evaluate": "var s=JSON.parse(localStorage.getItem('chistansara_game_save_v2')); s.completedLevels['3']={stars:3,solvedAt:3}; s.currentLevel=4; s.coins=280; localStorage.setItem('chistansara_game_save_v2', JSON.stringify(s)); Object.keys(JSON.parse(localStorage.getItem('chistansara_game_save_v2')).completedLevels).length",
        "expectValue": 3
      },
      {
        "wait": 1500
      },
      {
        "expectCall": "NativeAds.showInterstitial"
      }
    ]
  },
